# Worker 24/7 do agent-engine (fusão Vendaval) — processo long-running fora do Next.
# Roda TS direto via tsx (sem build): o worker é I/O-bound e o cold start não importa.
# ponytail: imagem single-stage com devDeps (tsx precisa); multi-stage + prune é Fase 4.
FROM node:22-alpine

WORKDIR /app

# Procedência (doutrina de packaging, invariante 2).
LABEL org.opencontainers.image.source="https://github.com/melgarafael/DeskcommCRM" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="DeskcommCRM worker"

ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION
# pnpm fixado na versão do lockfile do repo (pnpm 10 bloquearia build scripts).
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# Patch do @react-pdf/hyphenate (vendor não corrige o `exports` map). O strict export
# validation do Node 22 (ESM) recusa o wildcard `./.*` e quebra o require interno
# do textkit: `./en-us` não existe, então event-log drain falha. Adiciona entries
# explícitos para TODAS as locales que o hyphenate conhece, via fs direto do disco
# (sem patch em runtime que se perde no rebuild).
#
# pnpm mantém o hyphenate em dois lugares: `.pnpm/@react-pdf+hyphenate@*/...` (a
# entry canônica) E `.pnpm/@react-pdf+textkit@*/node_modules/@react-pdf/hyphenate`
# (symlink resolvido via dependência do textkit). Patch em SÓ um deles deixa o
# `require` do textkit voltando a falhar — o script cobre os dois.
COPY patches/hyphenate-exports.cjs /tmp/hyphenate-exports.cjs
RUN node /tmp/hyphenate-exports.cjs /app/node_modules && \
    mkdir -p /app/node_modules/@react-pdf && \
    HYPH=$(find /app/node_modules -name hyphenate -type d -path '*@react-pdf*' | head -1) && \
    ln -sf "$HYPH" /app/node_modules/@react-pdf/hyphenate

# Healthz do worker (bind 0.0.0.0 dentro do container).
EXPOSE 8787

CMD ["pnpm", "exec", "tsx", "workers/agent-worker/main.ts"]
