# Worker 24/7 do agent-engine (fusão Vendaval) — processo long-running fora do Next.
# Roda TS direto via tsx (sem build): o worker é I/O-bound e o cold start não importa.
# ponytail: imagem single-stage com devDeps (tsx precisa); multi-stage + prune é Fase 4.
FROM node:22-alpine

WORKDIR /app

# Procedência (doutrina de packaging, invariante 2).
LABEL org.opencontainers.image.source="https://github.com/melgarafael/DeskcommCRM" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="DeskcommCRM worker"

ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION
# pnpm fixado na versão do lockfile do repo (pnpm 10 bloquearia build scripts).
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# Patch do @react-pdf/hyphenate (vendor não corrige o `exports` map). O strict export
# validation do Node 22 (ESM) recusa o wildcard `./.*` e quebra o require interno
# do textkit: `./en-us` não existe, então event-log drain fica OFF. Adiciona
# entries explícitos para TODAS as locales (pnpm guarda hyphenate em dois paths
# — canônico e via textkit — `find -exec` cobre os dois).
RUN set -eux; \
    find /app/node_modules -path '*@react-pdf*hyphenate' -name package.json -exec node -e 'const fs=require("fs");const p=process.argv[1];const dir=p.replace("/package.json","");const pkg=JSON.parse(fs.readFileSync(p,"utf8"));const files=fs.readdirSync(dir).filter(f=>f.endsWith(".aff")||f.endsWith(".dic")||f.endsWith(".json")||/^[a-z]{2}(-[a-z0-9]+)?$/.test(f));const m={...(pkg.exports||{})};for(const f of files){if(!m["./"+f])m["./"+f]=f;}pkg.exports=m;fs.writeFileSync(p,JSON.stringify(pkg,null,2));console.log("patched",dir,files.length);' {} \; ; \
    mkdir -p /app/node_modules/@react-pdf; \
    HYPH=$(find /app/node_modules -name hyphenate -type d -path '*@react-pdf*' | head -1); \
    ln -sf "$HYPH" /app/node_modules/@react-pdf/hyphenate

# Healthz do worker (bind 0.0.0.0 dentro do container).
EXPOSE 8787

CMD ["pnpm", "exec", "tsx", "workers/agent-worker/main.ts"]
